{
  "name": "test-cartographer",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm test:unit && pnpm test:component && pnpm test:integration",
    "test:unit": "node --test \"packages/*/test/*.test.ts\"",
    "test:component": "pnpm --filter @tc/desktop test",
    "test:integration": "node --test --test-concurrency=1 --test-timeout=300000 --test-force-exit \"packages/*/test/integration/*.test.ts\"",
    "test:e2e": "pnpm --filter @tc/desktop build && playwright test -c tests/e2e/playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/desktop/tsconfig.json",
    "demo": "node demo/shop/server.ts",
    "tc": "node packages/engine/src/cli.ts",
    "start": "pnpm --filter @tc/desktop build && node packages/engine/src/cli.ts serve --open",
    "ui": "pnpm --filter @tc/desktop dev",
    "app": "pnpm --filter @tc/desktop app"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
